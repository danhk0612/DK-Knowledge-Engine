<Window x:Class="DKKnowledgeAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Knowledge Engine — 관리자" Width="1030" Height="790" Icon="pack://application:,,,/Assets/admin.ico"
        MinWidth="760" MinHeight="590">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="#D2D7DF" BorderThickness="0,0,0,1" Padding="0,0,0,14">
      <StackPanel>
        <TextBlock Text="DK Knowledge Engine Admin" FontWeight="SemiBold" FontSize="24"/>
        <TextBlock Text="제작자 전용 · 원본 문서와 색인 도구는 사용자 패키지에 포함되지 않습니다."
                   Foreground="#566273" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="1" Margin="0,16,0,0">
      <TabItem Header="1. 제품 정보">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="22" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="배포할 제품 정보" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="이 정보를 한 번 지정하면 DB 제작과 사용자 패키지에 동일하게 적용합니다."
                       Foreground="#566273" Margin="0,8,0,20" TextWrapping="Wrap"/>
            <TextBlock Text="제품명" FontWeight="SemiBold"/>
            <TextBox x:Name="ProductNameBox" Padding="9" Margin="0,6,0,18"/>
            <TextBlock Text="제품 버전" FontWeight="SemiBold"/>
            <TextBox x:Name="ProductVersionBox" Padding="9" Margin="0,6,0,4"/>
            <TextBlock Text="예: 1.0.0 (숫자와 점만 사용, 검색 시 문서의 적용 버전을 판단합니다.)"
                       Foreground="#566273" Margin="0,0,0,18" TextWrapping="Wrap"/>
            <Expander Header="고급 설정 · 내부 제품 ID" Margin="0,0,0,18">
              <StackPanel Margin="8">
                <TextBlock Text="문서와 지식 DB를 구분하는 내부 식별자입니다. 변경하면 DB를 다시 만들어야 합니다."
                           TextWrapping="Wrap" Foreground="#566273" Margin="0,0,0,8"/>
                <TextBox x:Name="ProductIdBox" Padding="8" Margin="0,0,0,8"/>
                <Button Content="제품 ID 새로 생성" Click="GenerateProductIdClick"
                        HorizontalAlignment="Left" Padding="14,7"/>
              </StackPanel>
            </Expander>
            <Button Content="제품 정보 저장" Click="SaveProductInfoClick" Padding="18,9"
                    HorizontalAlignment="Left"/>
            <TextBlock x:Name="ProductInfoStatus" Margin="0,14,0,0"
                       Foreground="#566273" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="2. 문서 · 지식 DB">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel x:Name="DeveloperRepoPanel" Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="소스 저장소 경로" FontWeight="SemiBold"/>
            <DockPanel Margin="0,5,0,0">
              <Button Content="탐색기 열기" DockPanel.Dock="Right" Padding="12,7"
                      Margin="10,0,0,0" Click="OpenRepoFolderClick"/>
              <TextBox x:Name="RepoBox" Padding="8"/>
            </DockPanel>
          </StackPanel>
          <StackPanel x:Name="DeveloperPythonPanel" Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="개발용 Python 경로 (실행 시 자동 확인, 필요하면 수정 가능)"/>
            <TextBox x:Name="PythonBox" Padding="8" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="원본 문서 폴더 (기본 자동 설정 · 문서 추가 시 이 폴더로 복사)" FontWeight="SemiBold"/>
            <DockPanel Margin="0,5,0,0">
              <Button Content="폴더 선택" DockPanel.Dock="Right" Padding="12,7"
                      Margin="10,0,0,0" Click="ChooseSourceClick"/>
              <Button Content="탐색기 열기" DockPanel.Dock="Right" Padding="12,7"
                      Margin="10,0,0,0" Click="OpenSourceFolderClick"/>
              <TextBox x:Name="SourceBox" Padding="8" TextChanged="SourceBoxTextChanged"/>
            </DockPanel>
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="원본 폴더의 모든 문서 등록·교체·삭제 (DB 반영은 재생성 버튼)" FontWeight="SemiBold"/>
            <DockPanel Margin="0,6,0,8">
              <TextBlock Text="일반 폴더 문서 제품 ID" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="ManageProductBox" IsReadOnly="True" Width="220" Padding="6" ToolTip="제품 정보 화면에서 관리합니다."/>
              <Button Content="문서 추가" ToolTip="선택 파일을 원본 문서 폴더 최상위에 복사" Padding="12,6" Margin="10,0,0,0" Click="AddDocumentClick"/>
              <Button Content="목록 새로고침" Padding="12,6" Margin="10,0,0,0" Click="RefreshDocumentsClick"/>
            </DockPanel>
            <ListBox x:Name="DocumentsList" Height="105" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="선택 문서 교체" Padding="14,6" Click="ReplaceDocumentClick"/>
              <Button Content="선택 문서 삭제" Padding="14,6" Margin="10,0,0,0"
                      Click="DeleteDocumentClick"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="지식 DB 저장 위치 (기본값 자동 설정)" FontWeight="SemiBold"/>
            <DockPanel Margin="0,5,0,0">
              <Button Content="저장 위치" DockPanel.Dock="Right" Padding="12,7"
                      Margin="10,0,0,0" Click="ChooseDbClick"/>
              <Button Content="탐색기 열기" DockPanel.Dock="Right" Padding="12,7"
                      Margin="10,0,0,0" Click="OpenDbFolderClick"/>
              <TextBox x:Name="DbBox" Padding="8"/>
            </DockPanel>
          </StackPanel>
          <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <Expander Header="고급 설정 · PDF 인식 / 제작용 AI / 의미 검색" IsExpanded="False" Margin="0,5,0,12">
              <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <CheckBox x:Name="PdfLayoutBox" Content="PDF 레이아웃 보존 추출" VerticalAlignment="Center"
                        ToolTip="텍스트 기반 표·다단 문서에서 pypdf의 레이아웃 모드를 시도합니다."/>
              <CheckBox x:Name="PdfOcrBox" Content="스캔 PDF OCR" Margin="18,0,0,0" VerticalAlignment="Center"
                        ToolTip="텍스트 없는 PDF 페이지를 제작자 PC의 Tesseract(kor+eng)와 Poppler(pdftoppm)로 처리합니다. 두 도구가 PATH에 필요합니다."/>
            </StackPanel>
            <TextBlock Text="일반 검색은 별도 모델 없이 동작합니다. 제작용 AI를 켜면 문서를 분석해 예상 질문·검색 표현을 사전에 추가합니다. 이 모델은 Client ZIP에 포함되지 않습니다."
                       TextWrapping="Wrap" Foreground="#566273" Margin="0,4,0,10"/>
            <CheckBox x:Name="AuthorEnrichmentBox" Content="제작용 AI로 문서 검색 표현 보강 (시간이 걸림, 사용자 패키지에 제작 모델 미포함)"
                      FontWeight="SemiBold" Margin="0,3,0,7" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <RadioButton x:Name="AuthorModeServer" Content="로컬 AI 서버" GroupName="AuthorMode"
                           IsChecked="True" Checked="AuthorModeChanged"/>
              <RadioButton x:Name="AuthorModeGguf" Content="GGUF 직접 실행" GroupName="AuthorMode"
                           Margin="20,0,0,0" Checked="AuthorModeChanged"/>
            </StackPanel>
            <StackPanel x:Name="AuthorServerPanel">
              <TextBlock Text="로컬 PC에서 이미 실행 중인 OpenAI 호환 /v1/chat/completions 서버만 연결합니다. 인터넷 AI 서비스는 지원하지 않습니다."
                         Foreground="#566273" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="로컬 제작 AI 서버 (선택)" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="AuthorEndpointBox" Padding="6" MinWidth="370"
                       ToolTip="예: http://127.0.0.1:8080/v1/chat/completions. 입력하면 로컬 GGUF/실행 파일 대신 사용합니다."/>
              <TextBlock Text="모델 ID" VerticalAlignment="Center" Margin="10,0,5,0"/>
              <TextBox x:Name="AuthorEndpointModelBox" Padding="6" Width="95" Text="local"/>
            </StackPanel>
            </StackPanel>
            <StackPanel x:Name="AuthorGgufPanel" Visibility="Collapsed">
              <TextBlock Text="제작용 GGUF와 llama.cpp 실행 파일을 지정합니다. GPU layers는 모델에서 GPU에 올릴 층 수이며 0은 CPU 실행입니다."
                         TextWrapping="Wrap" Foreground="#566273" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="제작용 GGUF 선택" Padding="12,6"
                      Margin="10,0,0,0" Click="ChooseAuthorModelClick"/>
              <TextBox x:Name="AuthorModelBox" Padding="6"
                       ToolTip="DB 생성에만 사용할 GGUF 모델. 사용자에게 배포할 GGUF와 독립적입니다."/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="실행 파일 선택" Padding="12,6"
                      Margin="10,0,0,0" Click="ChooseAuthorRuntimeClick"/>
              <TextBox x:Name="AuthorRuntimeBox" Padding="6"
                       ToolTip="비워두면 포터블 엔진의 runtime/llama-completion.exe를 사용합니다. GPU용은 직접 선택할 수 있습니다."/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
              <TextBlock Text="제작용 프롬프트" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="AuthorPromptBox" Width="132" SelectedIndex="0" ToolTip="raw_chatml: ChatML 토큰을 직접 구성 / qwen3: Qwen3 모델 템플릿 + 추론 출력 끄기 / jinja: GGUF에 내장된 채팅 템플릿 사용">
                <ComboBoxItem Content="raw_chatml"/>
                <ComboBoxItem Content="qwen3"/>
                <ComboBoxItem Content="jinja"/>
              </ComboBox>
              <TextBlock Text="GPU layers" VerticalAlignment="Center" Margin="15,0,7,0"/>
              <TextBox x:Name="AuthorGpuLayersBox" Width="52" Text="0" Padding="5"/>
            </StackPanel>
            </StackPanel>
            <TextBlock Text="경량 의미 검색: 검색어와 문서의 의미를 벡터로 비교합니다. 인코더 GGUF는 사용자 Client에도 동일한 파일로 포함해야 합니다."
                       TextWrapping="Wrap" Foreground="#566273" Margin="0,4,0,8"/>
            <CheckBox x:Name="EmbeddingIndexBox"
                      Content="의미 검색용 문서 벡터 생성 (제작 PC 전용, 사용자 모델은 별도 선택)"
                      FontWeight="SemiBold" Margin="0,2,0,7"/>
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="임베딩 GGUF 선택" Padding="12,6"
                      Margin="10,0,0,0" Click="ChooseEmbeddingModelClick"/>
              <TextBox x:Name="EmbeddingModelBox" Padding="6"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="임베딩 실행 파일 선택" Padding="12,6"
                      Margin="10,0,0,0" Click="ChooseEmbeddingRuntimeClick"/>
              <TextBox x:Name="EmbeddingRuntimeBox" Padding="6"
                       ToolTip="비워두면 포터블 엔진의 runtime/llama-embedding.exe를 사용합니다."/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="임베딩 프로필" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="EmbeddingProfileBox" Width="144" SelectedIndex="0" ToolTip="generic: 별도 접두어 없음 / e5: query: 및 passage: 접두어를 사용하는 E5 계열 임베딩 모델용">
                <ComboBoxItem Content="generic"/>
                <ComboBoxItem Content="e5"/>
              </ComboBox>
              <TextBlock Text="GPU layers" VerticalAlignment="Center" Margin="14,0,7,0"/>
              <TextBox x:Name="EmbeddingGpuLayersBox" Width="52" Padding="5" Text="0"/>
            </StackPanel>
              </StackPanel>
            </Expander>
            <StackPanel Orientation="Horizontal">
              <Button Content="지식 DB 재생성" Padding="20,9" Click="BuildDbClick"/>
              <Button Content="품질 보고서 열기" Padding="14,9" Margin="10,0,0,0" Click="OpenQualityReportClick"/>
              <TextBlock Text="DB 옆 .quality.json 파일"
                         Foreground="#566273" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <TextBox x:Name="BuildLog" Grid.Row="6" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   MinHeight="140" Padding="12" Text="문서를 등록한 뒤 지식 DB를 재생성하세요."/>
        </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="3. 사용자 패키지 제작">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
          <TextBlock Text="사용자 전용 패키지 만들기" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="사용자에게 표시할 프로그램명" FontWeight="SemiBold" Margin="0,16,0,0"/>
          <TextBox x:Name="PackageAppNameBox" Text="DK Knowledge Client" Padding="8" Margin="0,5,0,8"/>
          <TextBlock Text="Client EXE와 창·작업 표시줄·트레이에 적용할 아이콘" FontWeight="SemiBold"/>
          <DockPanel Margin="0,5,0,6">
            <Button Content="아이콘 선택" DockPanel.Dock="Right" Padding="12,7" Margin="10,0,0,0"
                    Click="ChoosePackageIconClick"/>
            <Button Content="기본 아이콘" DockPanel.Dock="Right" Padding="12,7" Margin="10,0,0,0"
                    Click="ClearPackageIconClick"/>
            <TextBox x:Name="PackageIconPathBox" IsReadOnly="True" Padding="8" Text="기본 제공 아이콘"/>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="62" Height="62" Background="#F0F3F6" CornerRadius="8"
                    VerticalAlignment="Center">
              <Image x:Name="PackageIconPreview" Width="52" Height="52"/>
            </Border>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#566273"
                       TextWrapping="Wrap" MaxWidth="620"
                       Text="PNG 또는 ICO를 선택할 수 있습니다. 이미지가 없어도 기본 아이콘을 제공합니다. 패키지 생성 시 16·32·48·256px EXE 아이콘을 적용합니다."/>
          </StackPanel>
          <TextBlock Text="기존 검증된 포터블 엔진과 현재 지식 DB를 결합합니다. 관리자 실행 파일·문서 변환 도구는 포함하지 않습니다."
                     TextWrapping="Wrap" Margin="0,8,0,18" Foreground="#566273"/>
          <TextBlock Text="포터블 엔진 폴더 (독립형 관리자에서 자동 지정)" FontWeight="SemiBold"/>
          <DockPanel Margin="0,5,0,16">
            <Button DockPanel.Dock="Right" Content="폴더 선택" Click="ChooseEngineClick"
                    Padding="12,7" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="탐색기 열기" Click="OpenEngineFolderClick"
                    Padding="12,7" Margin="10,0,0,0"/>
            <TextBox x:Name="EngineBox" Padding="8"/>
          </DockPanel>
          <TextBlock Text="사용자용 AI 모델 (GGUF, 선택하지 않으면 기본 Qwen3 1.7B)" FontWeight="SemiBold"/>
          <TextBlock Text="질문에 답변하는 모델입니다. DB를 제작할 때 사용하는 AI와 별개입니다."
                     Foreground="#566273" TextWrapping="Wrap" Margin="0,5,0,8"/>
          <DockPanel Margin="0,5,0,8">
            <Button DockPanel.Dock="Right" Content="GGUF 선택" Padding="12,7"
                    Margin="10,0,0,0" Click="ChoosePackageModelClick"/>
            <TextBox x:Name="PackageModelBox" Padding="8"/>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <TextBlock Text="프롬프트 형식" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="PackagePromptModeBox" Width="160" SelectedIndex="0" ToolTip="raw_chatml: ChatML 직접 구성 / qwen3: Qwen3 템플릿과 추론 끄기 / jinja: 모델 GGUF에 내장된 채팅 템플릿 사용">
              <ComboBoxItem Content="raw_chatml"/>
              <ComboBoxItem Content="qwen3"/>
              <ComboBoxItem Content="jinja"/>
            </ComboBox>
          </StackPanel>
          <TextBlock Text="선택 모델은 사용자 ZIP의 models 폴더에 포함합니다. 현재 llama.cpp 런타임과 프롬프트 형식에 호환되는 GGUF를 선택하세요."
                     Foreground="#566273" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <TextBlock Text="프롬프트 형식은 모델이 질문을 받는 구조입니다. 기본 Qwen3에는 raw_chatml을 사용하고, 다른 GGUF는 해당 모델의 설명에 맞춰 선택하세요."
                     Foreground="#566273" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <CheckBox x:Name="PackageEmbeddingBox" Content="경량 의미 검색 모델 포함 (추가 모델 파일 용량 필요)"
                    FontWeight="SemiBold" Margin="0,4,0,7"/>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="임베딩 GGUF 선택" Padding="12,7"
                    Margin="10,0,0,0" Click="ChoosePackageEmbeddingModelClick"/>
            <TextBox x:Name="PackageEmbeddingModelBox" Padding="8"
                     ToolTip="비워두면 지식 DB 제작 화면의 임베딩 GGUF를 사용합니다. DB 생성 시 사용한 동일 파일이어야 합니다."/>
          </DockPanel>
          <TextBlock Text="임베딩 GGUF는 DB 제작에 사용한 모델과 정확히 일치해야 하며, 사용자가 검색할 때 의미가 비슷한 문서도 찾도록 합니다."
                     Foreground="#566273" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <TextBlock Text="사용자 패키지 출력 폴더 (기본 자동 설정 · 기존 폴더 사용 가능)" FontWeight="SemiBold"/>
          <DockPanel Margin="0,5,0,16">
            <Button DockPanel.Dock="Right" Content="탐색기 열기" Click="OpenPackageOutputFolderClick"
                    Padding="12,7" Margin="10,0,0,0"/>
            <TextBox x:Name="PackageOutputBox" Padding="8"/>
          </DockPanel>
          <Button Content="사용자 패키지 생성" HorizontalAlignment="Left" Padding="20,9"
                  Click="PackageClick"/>
          <TextBlock x:Name="PackageRequirementsText" Text="동일한 출력 파일은 덮어씁니다. 기존 폴더의 무관한 파일은 유지합니다. 독립형 관리자에는 Python·.NET SDK가 필요하지 않습니다."
                     Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#566273"/>
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="4. 검증">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,12">
              <TextBlock Text="제품 ID"/>
              <TextBox x:Name="ProductBox" Padding="8" IsReadOnly="True"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,12">
              <TextBlock Text="제품 버전 (제품 정보에서 지정)"/>
              <TextBox x:Name="VersionBox" Padding="8" IsReadOnly="True"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,0,12">
              <TextBlock Text="API 포트"/>
              <TextBox x:Name="PortBox" Padding="8" Text="8765"/>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="1" Text="질문" FontWeight="SemiBold"/>
          <TextBox x:Name="QuestionBox" Grid.Row="2" Margin="0,6,0,12"
                   Text="수신기와 CRT의 IP 주소 대역은 어떻게 설정해야 하나요?"
                   MinHeight="75" Padding="8" TextWrapping="Wrap" AcceptsReturn="True"/>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="AI 답변 시험" Padding="18,8" Click="TestChatClick"/>
            <Button Content="문서 검색 시험" Padding="18,8" Margin="10,0,0,0" Click="TestSearchClick"/>
          </StackPanel>
          <TextBox x:Name="TestLog" Grid.Row="4" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12"/>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="StatusText" Grid.Row="2" Padding="6,12,0,0" Text="준비"
               TextWrapping="Wrap"/>
  </Grid>
</Window>
