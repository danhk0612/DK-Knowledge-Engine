<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../../assets/generated/client.ico</ApplicationIcon>
    <AssemblyName>DK-Knowledge-Client</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../../assets/generated/client.ico" Link="Assets/client.ico" />
    <Compile Include="../Shared/LocalApiClient.cs" Link="Shared/LocalApiClient.cs" />
  </ItemGroup>
  <Target Name="GenerateDefaultClientIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\assets\Generate-Icon.ps1&quot; -Kind client -Output &quot;$(MSBuildProjectDirectory)\..\..\assets\generated\client.ico&quot;" />
  </Target>
</Project>
