<Window x:Class="DKKnowledgeClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Knowledge Engine — 사용자" Width="840" Height="690"
        MinWidth="680" MinHeight="550">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="#D2D7DF" BorderThickness="0,0,0,1" Padding="0,0,0,14">
      <StackPanel>
        <TextBlock Text="DK Knowledge Engine" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="로컬 AI 도움말 · 사용자 프로그램" Foreground="#566273" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="1" Margin="0,16,0,0">
      <TabItem Header="AI 질문 · 검색">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,10">
              <TextBlock Text="제품 ID" FontWeight="SemiBold"/>
              <TextBox x:Name="ProductIdBox" Text="example-program" Padding="8" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,0,10">
              <TextBlock Text="제품 버전 (선택)"/>
              <TextBox x:Name="VersionBox" Padding="8" Margin="0,5,0,0"/>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1">
            <TextBlock Text="질문 또는 검색어" FontWeight="SemiBold"/>
            <TextBox x:Name="QuestionBox" Text="데이터베이스 연결 오류 시 확인할 포트는?"
                     Padding="8" Margin="0,5,0,10" MinHeight="60" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="AI 답변" Padding="18,8" Click="AskClick"/>
            <Button Content="문서 검색" Padding="18,8" Margin="10,0,0,0" Click="SearchClick"/>
          </StackPanel>
          <Grid Grid.Row="3">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="답변 및 출처" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="AnswerBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="12"
                     Text="엔진을 실행하거나 연결한 뒤 질문하세요."/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="엔진 제어">
        <StackPanel Margin="18">
          <TextBlock Text="로컬 엔진" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="이 PC에서만 동작하며, 기존에 실행 중인 다른 엔진을 임의로 종료하지 않습니다."
                     TextWrapping="Wrap" Margin="0,8,0,16" Foreground="#566273"/>
          <TextBlock x:Name="PortText" Margin="0,0,0,14"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="엔진 실행" Padding="18,9" Click="StartEngineClick"/>
            <Button Content="엔진 중지" Padding="18,9" Margin="10,0,0,0" Click="StopEngineClick"/>
            <Button Content="상태 확인" Padding="18,9" Margin="10,0,0,0" Click="HealthClick"/>
          </StackPanel>
          <TextBlock x:Name="EngineStatusText" Margin="0,20,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="지식 DB 업데이트">
        <StackPanel Margin="18">
          <TextBlock Text="관리자가 전달한 지식 DB 적용" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="원본 문서 등록 및 색인 기능은 관리자용에만 있습니다. 업데이트 전 로컬 엔진을 종료하세요."
                     TextWrapping="Wrap" Foreground="#566273" Margin="0,8,0,18"/>
          <TextBlock Text="새 knowledge.db 파일"/>
          <DockPanel Margin="0,6,0,16">
            <Button Content="찾기..." DockPanel.Dock="Right" Padding="12,7"
                    Margin="10,0,0,0" Click="ChooseDbClick"/>
            <TextBox x:Name="DbPathBox" Padding="8"/>
          </DockPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="DB 적용" Padding="16,9" Click="ApplyDbClick"/>
            <Button Content="이전 DB 복구" Margin="10,0,0,0" Padding="16,9" Click="RollbackDbClick"/>
            <Button Content="무결성 검사" Margin="10,0,0,0" Padding="16,9" Click="VerifyClick"/>
          </StackPanel>
          <TextBlock Text="업데이트는 기존 검증된 Update-Knowledge.ps1을 호출합니다."
                     Margin="0,18,0,0" Foreground="#566273"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="StatusText" Grid.Row="2" Padding="6,12,0,0" TextWrapping="Wrap"
               Text="준비"/>
  </Grid>
</Window>
