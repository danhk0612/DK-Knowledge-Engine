<Window x:Class="DKKnowledgeClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Knowledge Client" Width="950" Height="780"
        MinWidth="760" MinHeight="610"
        Icon="pack://application:,,,/Assets/client.ico"
        Closing="WindowClosing">
  <Grid Margin="22" Background="#F8FAFC">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="White" CornerRadius="12" Padding="20,16">
      <DockPanel LastChildFill="True">
        <Border Background="#E8F5F3" CornerRadius="12" Width="56" Height="56" DockPanel.Dock="Left"
                Margin="0,0,15,0">
          <Image x:Name="HeaderAppIcon" Width="45" Height="45"/>
        </Border>
        <TextBlock x:Name="HeaderEngineStatusText" DockPanel.Dock="Right"
                   Text="엔진 연결 대기" VerticalAlignment="Center"
                   Foreground="#376070" Margin="15,0,0,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="AppTitleText" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock x:Name="ProductInfoText" FontSize="13" Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,16,0,0"
                Background="White" BorderBrush="#E2E8F0">
      <TabItem x:Name="QuestionTab" Header="AI 질문 · 검색">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="무엇을 도와드릴까요?" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,12"/>
          <TextBox x:Name="QuestionBox" Grid.Row="1" MinHeight="82" MaxHeight="160"
                   TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                   Padding="12" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,15">
            <Button Content="AI 질문" Padding="20,10" Click="AskClick"/>
            <Button Content="문서 검색" Padding="20,10" Margin="10,0,0,0" Click="SearchClick"/>
            <TextBlock Text="답변과 근거 문서의 출처를 함께 표시합니다." Foreground="#64748B"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
          </StackPanel>
          <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="답변 · 검색 결과 · 출처" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <TextBox x:Name="AnswerBox" Grid.Row="1" IsReadOnly="True"
                     Background="#F8FAFC" TextWrapping="Wrap" Padding="14"
                     VerticalScrollBarVisibility="Auto"
                     Text="설명서에서 궁금한 내용을 질문하세요."/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="ApiTab" Header="API 도구">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="로컬 API 테스트" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,8"/>
          <TextBlock Grid.Row="1" Text="이 PC의 127.0.0.1에서 제공되는 네 가지 기존 API만 호출합니다."
                     Foreground="#64748B" Margin="0,0,0,14"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox x:Name="ApiEndpointBox" Width="180" SelectionChanged="ApiEndpointChanged"
                      SelectedIndex="0">
              <ComboBoxItem Content="GET /health" Tag="health"/>
              <ComboBoxItem Content="POST /search" Tag="search"/>
              <ComboBoxItem Content="POST /chat" Tag="chat"/>
              <ComboBoxItem Content="POST /event" Tag="event"/>
            </ComboBox>
            <TextBlock x:Name="ApiUrlText" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="#475569"/>
          </StackPanel>
          <TextBlock Grid.Row="3" Text="요청 JSON (필요하면 편집 가능)" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="ApiRequestBox" AcceptsReturn="True" TextWrapping="Wrap"
                     Padding="12" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="요청 보내기" Padding="18,9" Click="ApiSendClick"/>
              <Button Content="요청 복사" Padding="18,9" Margin="10,0,0,0" Click="ApiCopyClick"/>
              <TextBlock x:Name="ApiStatusText" VerticalAlignment="Center"
                         Foreground="#64748B" Margin="15,0,0,0"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="5">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="응답 JSON" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBox x:Name="ApiResultBox" Grid.Row="1" IsReadOnly="True"
                     FontFamily="Consolas" Background="#F8FAFC" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="12"/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="KnowledgeTab" Header="지식 DB 관리">
        <StackPanel Margin="22">
          <TextBlock Text="지식 DB 업데이트" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="관리자가 전달한 같은 제품의 knowledge.db 파일만 적용할 수 있습니다. 원본 문서와 제작 도구는 포함되지 않습니다."
                     TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,20"/>
          <TextBlock Text="새 knowledge.db 파일" FontWeight="SemiBold"/>
          <DockPanel Margin="0,8,0,15">
            <Button Content="파일 찾기" DockPanel.Dock="Right" Padding="16,9"
                    Margin="10,0,0,0" Click="ChooseDbClick"/>
            <TextBox x:Name="DbPathBox" Padding="10"/>
          </DockPanel>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ApplyDbButton" Content="DB 업데이트" Padding="18,10" Click="ApplyDbClick"/>
            <Button x:Name="RollbackDbButton" Content="이전 DB 복구" Padding="18,10" Margin="10,0,0,0" Click="RollbackDbClick"/>
            <Button Content="무결성 검사" Padding="18,10" Margin="10,0,0,0" Click="VerifyClick"/>
          </StackPanel>
          <TextBlock Text="이 프로그램이 시작한 엔진은 업데이트 전에 자동으로 중지하고, 업데이트 성공 후 다시 시작합니다. 외부에서 실행한 엔진은 중지하지 않습니다."
                     TextWrapping="Wrap" Foreground="#64748B" Margin="0,22,0,0"/>
        </StackPanel>
      </TabItem>
      <TabItem x:Name="SettingsTab" Header="설정">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="22">
            <TextBlock Text="프로그램 설정" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBlock Text="제품 정보 (관리자가 지정함)" FontWeight="SemiBold"/>
            <TextBlock x:Name="SettingsProductText" Foreground="#64748B" Margin="0,8,0,20"/>
            <TextBlock Text="로컬 엔진 / API 포트" FontWeight="SemiBold"/>
            <TextBlock x:Name="PortText" Margin="0,8,0,12" Foreground="#64748B"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <TextBox x:Name="SettingsPortBox" Width="115" Padding="10"/>
              <Button x:Name="SavePortButton" Content="포트 저장" Padding="17,9" Margin="10,0,0,0" Click="SavePortClick"/>
              <TextBlock Text="기본 8765 · 서버는 127.0.0.1만 사용"
                         VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#64748B"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="StartEngineButton" Content="엔진 시작" Padding="17,9" Click="StartEngineClick"/>
              <Button x:Name="StopEngineButton" Content="엔진 중지" Padding="17,9" Margin="10,0,0,0" Click="StopEngineClick"/>
              <Button Content="상태 확인" Padding="17,9" Margin="10,0,0,0" Click="HealthClick"/>
            </StackPanel>
            <TextBlock x:Name="EngineStatusText" Margin="0,16,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="창의 X 버튼을 누르면 트레이에 유지됩니다. 완전히 끝내려면 트레이 아이콘을 우클릭하고 종료를 선택하세요."
                       Foreground="#64748B" TextWrapping="Wrap" Margin="0,25,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="StatusText" Grid.Row="2" Text="준비" Padding="8,12,0,0"
               Foreground="#475569" TextWrapping="Wrap"/>
  </Grid>
</Window>
